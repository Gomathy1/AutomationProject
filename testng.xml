<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- 
  This suite runs: Unit, API, UI, and Security tests (TestNG)
  Contract tests use JUnit5 and must be run separately: mvn test -Dtest=contract.consumer.*
-->
<suite name="Automation Test Suite">
    <test name="Unit Tests">
        <classes>
            <class name="unit.LoginPageUnitTest"/>
            <class name="unit.BasePageUnitTest"/>
            <class name="unit.DriverManagerUnitTest"/>
        </classes>
    </test>
    
    <test name="API Tests">
        <classes>
            <class name="api.UserAPITest"/>
            <class name="api.PostAPITest"/>
        </classes>
    </test>
    
    <test name="UI Tests">
        <classes>
            <class name="ui.LoginUITest"/>
            <class name="ui.HomepageUITest"/>
        </classes>
    </test>
    
    <test name="Security Tests">
        <classes>
            <class name="security.APISecurityTest"/>
            <class name="security.AuthenticationSecurityTest"/>
            <class name="security.HeaderSecurityTest"/>
        </classes>
    </test>
</suite>
